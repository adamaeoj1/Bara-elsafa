# =========================================================================
# Showtime / برا السالفة - Production Environment Variables
# =========================================================================

# 1. Supabase PostgreSQL & Realtime Configuration
# Obtain these from your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# 2. Payment Checkout URL for Paywall Modal
# Wire this to your Stripe Payment Link, Moyasar, Apple Pay, or Gumroad URL
VITE_PAYMENT_CHECKOUT_URL=https://buy.stripe.com/test_showtime_pass
